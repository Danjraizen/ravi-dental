<Layout head={head} navbar={navbar} footer={footer}>
<main id="main-content">
  <section class="page-header">
    <div class="container page-header-content">
      <h1>Our Dental Services</h1>
      <p>Complete oral care solutions from prevention to restoration</p>
      <div class="breadcrumb">
        <a href="/">Home</a><span class="sep">/</span><span>Services</span>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container">
      <div class="text-center" style="margin-bottom:3rem;">
        <span class="section-label">What We Offer</span>
        <h2 class="section-title" style="margin:0 auto 1rem;">A Wide Range of Services</h2>
        <p class="section-subtitle" style="margin:0 auto;">From preventive checkups and painless root canals to cosmetic smile makeovers and advanced implant treatments — all delivered with precision, care, and compassion.</p>
      </div>
      <div class="services-grid">
        <div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Teeth Whitening</h3>
          <p>Brighten your smile safely with professional teeth whitening treatments.</p>
          <a href="/services/teeth-whitening/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Tooth Restoration</h3>
          <p>Restore damaged teeth with advanced composite fillings and bonding.</p>
          <a href="/services/tooth-restoration/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Root Canal Treatment</h3>
          <p>Save infected teeth with painless, precise root canal therapy.</p>
          <a href="/services/root-canal-treatment/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Paediatric Dentistry</h3>
          <p>Gentle, friendly dental care tailored for children's growing smiles.</p>
          <a href="/services/paediatric-dentistry/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Extraction</h3>
          <p>Safe and gentle tooth extractions performed with utmost care.</p>
          <a href="/services/extraction/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Ceramic Crown</h3>
          <p>Durable, natural-looking ceramic crowns to protect and enhance teeth.</p>
          <a href="/services/ceramic-crown/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Veneers & Laminates</h3>
          <p>Transform your smile with custom veneers that cover imperfections.</p>
          <a href="/services/veneers-and-laminates/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Dental Implant</h3>
          <p>Permanent tooth replacement with titanium implants and custom crowns.</p>
          <a href="/services/dental-implant/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Fixed & Removable Dentures</h3>
          <p>Custom dentures designed for comfort, function, and natural appearance.</p>
          <a href="/services/fixed-and-removable-dentures/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Orthodontic Treatment</h3>
          <p>Straighten teeth and correct bites with modern braces and wires.</p>
          <a href="/services/orthodontic-treatment/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Invisible Aligners</h3>
          <p>Clear, removable aligners for discreet teeth straightening.</p>
          <a href="/services/invisible-aligners/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll">
          <div class="service-icon"><i class="fas fa-tooth"></i></div>
          <h3>Periodontal Treatment</h3>
          <p>Treat gum disease and maintain healthy gums with expert periodontal care.</p>
          <a href="/services/periodontal-treatment/" class="service-link">Read More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <div class="text-center" style="margin-bottom:3rem;">
        <span class="section-label">Also Available</span>
        <h2 class="section-title" style="margin:0 auto 1rem;">Orofacial Pain Treatments</h2>
        <p class="section-subtitle" style="margin:0 auto;">Beyond traditional dentistry, we specialize in diagnosing and treating complex orofacial pain conditions.</p>
      </div>
      <div class="services-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        <div class="service-card animate-on-scroll" style="border-left: 3px solid var(--accent);">
          <div class="service-icon" style="background: linear-gradient(135deg, var(--accent), var(--gold));"><i class="fas fa-heartbeat"></i></div>
          <h3>Dental Pain</h3>
          <p>Expert diagnosis and treatment for toothaches, pulpitis, abscesses, and post-procedural pain.</p>
          <a href="/pain-treatments/dental-pain/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll" style="border-left: 3px solid var(--accent);">
          <div class="service-icon" style="background: linear-gradient(135deg, var(--accent), var(--gold));"><i class="fas fa-heartbeat"></i></div>
          <h3>Headache</h3>
          <p>Identify and treat tension headaches, cervicogenic headaches, and referred orofacial pain.</p>
          <a href="/pain-treatments/headache/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll" style="border-left: 3px solid var(--accent);">
          <div class="service-icon" style="background: linear-gradient(135deg, var(--accent), var(--gold));"><i class="fas fa-heartbeat"></i></div>
          <h3>Migraine</h3>
          <p>Specialized care for migraines with orofacial triggers and trigeminal neuralgia connections.</p>
          <a href="/pain-treatments/migraine/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll" style="border-left: 3px solid var(--accent);">
          <div class="service-icon" style="background: linear-gradient(135deg, var(--accent), var(--gold));"><i class="fas fa-heartbeat"></i></div>
          <h3>Temporomandibular Joint Pain</h3>
          <p>Comprehensive TMJ/TMD diagnosis and therapy for jaw pain, clicking, and dysfunction.</p>
          <a href="/pain-treatments/temporomandibular-joint-pain/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll" style="border-left: 3px solid var(--accent);">
          <div class="service-icon" style="background: linear-gradient(135deg, var(--accent), var(--gold));"><i class="fas fa-heartbeat"></i></div>
          <h3>Snoring & Sleep Apnea</h3>
          <p>Oral appliance therapy for snoring and obstructive sleep apnea management.</p>
          <a href="/pain-treatments/snoring/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div><div class="service-card animate-on-scroll" style="border-left: 3px solid var(--accent);">
          <div class="service-icon" style="background: linear-gradient(135deg, var(--accent), var(--gold));"><i class="fas fa-heartbeat"></i></div>
          <h3>Undiagnosed Facial Pains</h3>
          <p>Advanced diagnostic protocols for persistent facial pain with no clear origin.</p>
          <a href="/pain-treatments/undiagnosed-facial-pains/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Not Sure Which Service You Need?</h2>
        <p>Schedule a consultation and our experts will guide you to the right treatment plan for your unique needs.</p>
        <a href="/contact/" class="btn btn-accent">Free Consultation</a>
      </div>
