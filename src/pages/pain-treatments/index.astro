<Layout head={head} navbar={navbar} footer={footer}>
<main id="main-content">
<section class="page-header">
  <div class="container page-header-content">
    <h1>Orofacial Pain Treatments</h1>
    <p>Relieving pain, restoring lives — specialized care for complex facial and head pain</p>
    <div class="breadcrumb">
      <a href="/">Home</a><span class="sep">/</span><span>Pain Treatments</span>
    </div>
  </div>
</section>

<section class="section-padding pain-section">
  <div class="container">
    <div class="text-center" style="margin-bottom:3rem;">
      <span class="section-label">Pain Management</span>
      <h2 class="section-title" style="margin:0 auto 1rem;">Relieving Pain, Restoring Lives</h2>
      <p class="section-subtitle" style="margin:0 auto;">Expert orofacial pain diagnosis and treatment for headaches, migraines, TMJ disorders, snoring, and unexplained facial pain. We don't just treat symptoms — we find and fix the root cause.</p>
    </div>
    <div class="pain-grid">
      <div class="pain-card animate-on-scroll">
        <div class="pain-card-icon"><i class="fas fa-tooth"></i></div>
        <h3>Dental Pain</h3>
        <p>Expert diagnosis and treatment for toothaches, pulpitis, abscesses, and post-procedural pain.</p>
        <a href="/pain-treatments/dental-pain/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
      </div>
      <div class="pain-card animate-on-scroll">
        <div class="pain-card-icon"><i class="fas fa-brain"></i></div>
        <h3>Headache</h3>
        <p>Identify and treat tension headaches, cervicogenic headaches, and referred orofacial pain.</p>
        <a href="/pain-treatments/headache/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
      </div>
      <div class="pain-card animate-on-scroll">
        <div class="pain-card-icon"><i class="fas fa-bolt"></i></div>
        <h3>Migraine</h3>
        <p>Specialized care for migraines with orofacial triggers and trigeminal neuralgia connections.</p>
        <a href="/pain-treatments/migraine/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
      </div>
      <div class="pain-card animate-on-scroll">
        <div class="pain-card-icon"><i class="fas fa-joint"></i></div>
        <h3>Temporomandibular Joint Pain</h3>
        <p>Comprehensive TMJ/TMD diagnosis and therapy for jaw pain, clicking, and dysfunction.</p>
        <a href="/pain-treatments/temporomandibular-joint-pain/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
      </div>
      <div class="pain-card animate-on-scroll">
        <div class="pain-card-icon"><i class="fas fa-bed"></i></div>
        <h3>Snoring & Sleep Apnea</h3>
        <p>Oral appliance therapy for snoring and obstructive sleep apnea management.</p>
        <a href="/pain-treatments/snoring/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
      </div>
      <div class="pain-card animate-on-scroll">
        <div class="pain-card-icon"><i class="fas fa-question-circle"></i></div>
        <h3>Undiagnosed Facial Pains</h3>
        <p>Advanced diagnostic protocols for persistent facial pain with no clear origin.</p>
        <a href="/pain-treatments/undiagnosed-facial-pains/" class="service-link">Learn More <i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></a>
      </div>
    </div>
  </div>
</section>

<section class="section-padding bg-gray-50">
  <div class="container">
    <div class="text-center" style="margin-bottom:3rem;">
      <span class="section-label">Why Choose Us</span>
      <h2 class="section-title" style="margin:0 auto 1rem;">Leaders in Orofacial Pain Management</h2>
      <p class="section-subtitle" style="margin:0 auto;">Dr. Ravi is among the few dental specialists in Chennai with dedicated training in orofacial pain diagnosis and management.</p>
    </div>
    <div class="why-grid">
      <div class="why-card animate-on-scroll">
        <div class="why-icon"><i class="fas fa-stethoscope"></i></div>
        <div>
          <h4>Advanced Diagnostics</h4>
          <p>Digital imaging, nerve conduction studies, and quantitative sensory testing to pinpoint the exact cause of your pain.</p>
        </div>
      </div>
      <div class="why-card animate-on-scroll">
        <div class="why-icon"><i class="fas fa-user-md"></i></div>
        <div>
          <h4>Specialized Expertise</h4>
          <p>Dr. Ravi has advanced training in orofacial pain — a recognized dental specialty focused on complex head, face, and neck pain.</p>
        </div>
      </div>
      <div class="why-card animate-on-scroll">
        <div class="why-icon"><i class="fas fa-hands-helping"></i></div>
        <div>
          <h4>Multidisciplinary Care</h4>
          <p>We coordinate with neurologists, ENT specialists, physiotherapists, and pain medicine experts for comprehensive treatment.</p>
        </div>
      </div>
      <div class="why-card animate-on-scroll">
        <div class="why-icon"><i class="fas fa-shield-alt"></i></div>
        <div>
          <h4>Evidence-Based Treatment</h4>
          <p>Every treatment plan is grounded in the latest clinical research and tailored to your specific diagnosis and lifestyle.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-padding cta-section">
  <div class="container">
    <div class="cta-content">
      <h2>Don't Let Pain Control Your Life</h2>
      <p>Schedule a comprehensive orofacial pain evaluation and discover the real cause of your symptoms.</p>
      <a href="/contact/" class="btn btn-accent">Book Pain Consultation</a>
    </div>
  </div>
</section>


</main>
</Layout>
