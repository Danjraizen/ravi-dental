    <div class="container">
      <div class="text-center" style="margin-bottom:3rem;">
        <span class="section-label">Meet The Team</span>
        <h2 class="section-title" style="margin:0 auto 1rem;">The Care You Need, The Service You Deserve</h2>
        <p class="section-subtitle" style="margin:0 auto;">Our team of dedicated professionals is here to make your dental experience comfortable and effective.</p>
      </div>
      <div class="team-grid">
        <div class="team-card animate-on-scroll">
          <div class="team-img-wrap">
            <img src="/team-avatar.svg" alt="Dr. Ravi - Chief Dentist and Orofacial Pain Specialist" class="team-img" loading="lazy">
          </div>
          <div class="team-info">
            <h4>Dr. Ravi</h4>
            <p>Chief Dentist & Orofacial Pain Specialist</p>
