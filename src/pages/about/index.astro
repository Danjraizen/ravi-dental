const head = "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>About Us | Dr. Ravi's Dental & Orofacial Pain Clinic Chennai</title>\n  <meta name=\"description\" content=\"Learn about Dr. Ravi's 15+ years of dental excellence in Mogappair, Chennai. Our mission, vision, values, and commitment to pain-free smiles.\">\n  <meta name=\"keywords\" content=\"dental clinic Chennai, orofacial pain, dentist Mogappair, root canal, dental implant, teeth whitening, TMJ treatment, migraine headache, facial pain specialist, Dr Ravi dental\">\n  <meta name=\"author\" content=\"Dr. Ravi's Dental and Orofacial Pain Clinic\">\n  <meta name=\"robots\" content=\"index, follow\">\n  <link rel=\"canonical\" href=\"https://mogappairdentalclinic.com/about/\">\n  <link rel=\"icon\" type=\"image/png\" href=\"/logo orofacial.png\">\n\n  <!-- Open Graph -->\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:url\" content=\"https://mogappairdentalclinic.com/about/\">\n  <meta property=\"og:title\" content=\"About Us | Dr. Ravi's Dental & Orofacial Pain Clinic Chennai\">\n  <meta property=\"og:description\" content=\"Learn about Dr. Ravi's 15+ years of dental excellence in Mogappair, Chennai. Our mission, vision, values, and commitment to pain-free smiles.\">\n  <meta property=\"og:image\" content=\"https://mogappairdentalclinic.com/logo orofacial.png\">\n  <meta property=\"og:site_name\" content=\"Dr. Ravi's Dental and Orofacial Pain Clinic\">\n\n  <!-- Twitter Card -->\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"About Us | Dr. Ravi's Dental & Orofacial Pain Clinic Chennai\">\n  <meta name=\"twitter:description\" content=\"Learn about Dr. Ravi's 15+ years of dental excellence in Mogappair, Chennai. Our mission, vision, values, and commitment to pain-free smiles.\">\n  <meta name=\"twitter:image\" content=\"https://mogappairdentalclinic.com/logo orof