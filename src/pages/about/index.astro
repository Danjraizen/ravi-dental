              <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            </div>
          </div>
        </div>
        <div class="team-card animate-on-scroll">
          <div class="team-img-wrap">
            <img src="/team-avatar.svg" alt="Dr. Vaishnav - Dental Surgeon" class="team-img" loading="lazy">
          </div>
          <div class="team-info">
            <h4>Dr. Vaishnav</h4>
            <p>Dental Surgeon & Implantologist</p>
            <div class="team-social">
              <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            </div>
          </div>
        </div>
        <div class="team-card animate-on-scroll">
          <div class="team-img-wrap">
            <img src="/team-avatar.svg" alt="Dr. Priya - Orthodontist" class="team-img" loading="lazy">
          </div>
          <div class="team-info">
            <h4>Dr. Priya</h4>
            <p>Orthodontist & Aligner Specialist</p>
            <div class="team-social">
              <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            </div>
