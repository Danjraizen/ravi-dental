<Layout head={head} navbar={navbar} footer={footer}>
<main id="main-content">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container page-header-content">
      <h1>About Our Clinic</h1>
      <p>Expert Doctors, Seamless Appointments, Quality Care</p>
      <div class="breadcrumb">
        <a href="/">Home</a><span class="sep">/</span><span>About Us</span>
      </div>
    </div>
  </section>

  <!-- About Content -->
  <section class="section-padding bg-gray-50">
    <div class="container">
      <div class="about-grid">
        <div class="about-images animate-on-scroll">
          <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80" alt="Dr. Ravi Dental Clinic Interior" class="about-img-main" loading="lazy">
          <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=600&q=80" alt="Advanced Dental Equipment" class="about-img-accent" loading="lazy">
          <div class="about-badge">
            <div class="about-badge-number">15+</div>
            <div class="about-badge-text">Years of<br>Excellence</div>
          </div>
        </div>
        <div class="animate-on-scroll">
          <span class="section-label">Who We Are</span>
          <h2 class="section-title">Dedicated to Your Oral Health & Comfort</h2>
          <p style="color:var(--gray-600);margin-bottom:1rem;line-height:1.8;">At Dr. Ravi's Dental and Orofacial Pain Clinic, we believe that everyone deserves a healthy, beautiful smile — and a life free from oral and facial pain. Founded by Dr. Ravi, our clinic has grown from a small dental practice into one of Chennai's most trusted destinations for comprehensive dental care and specialized orofacial pain management.</p>
          <p style="color:var(--gray-600);margin-bottom:1.5rem;line-height:1.8;">What sets us apart is our dual expertise. While we offer all standard dental services — from routine cleanings to complex implant surgeries — we also specialize in diagnosing and treating conditions that many patients struggle to find help for: chronic headaches, migraines triggered by dental issues, TMJ disorders, unexplained facial pain, and sleep-related breathing problems like snoring.</p>
          <div class="about-features">
            <div class="about-feature">
              <div class="about-feature-icon"><i class="fas fa-check"></i></div>
              <div><strong style="color:var(--dark);">Experienced & Gentle Dentist</strong><br><span style="font-size:0.9rem;color:var(--gray-500);">Dr. Ravi brings 15+ years of hands-on experience in both general and advanced dentistry</span></div>
            </div>
            <div class="about-feature">
              <div class="about-feature-icon"><i class="fas fa-check"></i></div>
              <div><strong style="color:var(--dark);">Modern Equipment & Sterilization</strong><br><span style="font-size:0.9rem;color:var(--gray-500);">Digital radiography, intra-oral cameras, and autoclave sterilization for maximum safety</span></div>
            </div>
            <div class="about-feature">
              <div class="about-feature-icon"><i class="fas fa-check"></i></div>
              <div><strong style="color:var(--dark);">Affordable & Transparent Pricing</strong><br><span style="font-size:0.9rem;color:var(--gray-500);">Detailed cost breakdowns before treatment begins — no surprises, no hidden fees</span></div>
            </div>
            <div class="about-feature">
              <div class="about-feature-icon"><i class="fas fa-check"></i></div>
              <div><strong style="color:var(--dark);">Emergency Care Available</strong><br><span style="font-size:0.9rem;color:var(--gray-500);">Acute toothaches, trauma, and severe pain treated with priority same-day appointments</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Vision Values -->
  <section class="section-padding">
    <div class="container">
      <div class="text-center" style="margin-bottom:3rem;">
        <span class="section-label">Our Philosophy</span>
        <h2 class="section-title" style="margin:0 auto 1rem;">Our Mission, Vision & Values</h2>
      </div>
      <div class="services-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
        <div class="service-card animate-on-scroll" style="text-align:center;">
          <div class="service-icon" style="margin:0 auto 1.25rem;"><i class="fas fa-bullseye"></i></div>
          <h3>Our Mission</h3>
          <p>To deliver exceptional dental care with compassion, precision, and integrity. We are committed to improving the oral health and overall well-being of every patient through personalized treatments, advanced technology, and a gentle approach that builds trust and long-term relationships.</p>
        </div>
        <div class="service-card animate-on-scroll" style="text-align:center;">
          <div class="service-icon" style="margin:0 auto 1.25rem;"><i class="fas fa-eye"></i></div>
          <h3>Our Vision</h3>
          <p>To be the most trusted dental and orofacial pain clinic in Chennai, recognized for clinical excellence, ethical practices, and patient-focused service. We strive to set new standards in modern dentistry by continuously embracing innovation and expanding our expertise.</p>
        </div>
        <div class="service-card animate-on-scroll" style="text-align:center;">
          <div class="service-icon" style="margin:0 auto 1.25rem;"><i class="fas fa-heart"></i></div>
          <h3>Our Values</h3>
          <p>Integrity, empathy, excellence, and innovation guide every aspect of our care. We uphold the highest standards to ensure that every smile we care for reflects our dedication. We treat every patient with kindness, respect, and personalized attention.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="section-padding bg-gray-50">
    <div class="container">
      <div class="text-center" style="margin-bottom:3rem;">
        <span class="section-label">What Drives Us</span>
        <h2 class="section-title" style="margin:0 auto 1rem;">Our Core Values</h2>
        <p class="section-subtitle" style="margin:0 auto;">The principles that guide every treatment, every interaction, and every decision we make.</p>
      </div>
      <div class="why-grid">
        <div class="why-card animate-on-scroll">
          <div class="why-icon"><i class="fas fa-hand-holding-heart"></i></div>
          <div>
            <h4>Patient-Centered Care</h4>
            <p>We prioritize your comfort and satisfaction with personalized treatment plans designed to suit your unique dental needs and pain concerns.</p>
          </div>
        </div>
        <div class="why-card animate-on-scroll">
          <div class="why-icon"><i class="fas fa-balance-scale"></i></div>
          <div>
            <h4>Integrity & Transparency</h4>
            <p>Honesty is at the heart of everything we do. From diagnoses to billing, we ensure clarity and fairness at every step.</p>
          </div>
        </div>
        <div class="why-card animate-on-scroll">
          <div class="why-icon"><i class="fas fa-handshake"></i></div>
          <div>
            <h4>Compassionate Approach</h4>
            <p>We treat every patient with kindness and empathy, creating a warm and stress-free environment for families and individuals alike.</p>
          </div>
        </div>
        <div class="why-card animate-on-scroll">
          <div class="why-icon"><i class="fas fa-award"></i></div>
          <div>
            <h4>Clinical Excellence</h4>
            <p>Led by skilled professionals, our clinic maintains the highest standards in dental care through continuous learning and quality practice.</p>
          </div>
        </div>
        <div class="why-card animate-on-scroll">
          <div class="why-icon"><i class="fas fa-microchip"></i></div>
          <div>
            <h4>Advanced Technology</h4>
            <p>We invest in the latest dental tools and innovations to provide safe, efficient, and pain-free treatments for every smile.</p>
          </div>
        </div>
        <div class="why-card animate-on-scroll">
          <div class="why-icon"><i class="fas fa-user-shield"></i></div>
          <div>
            <h4>Safety First</h4>
            <p>Rigorous sterilization protocols, disposable instruments where possible, and strict infection control for your peace of mind.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
