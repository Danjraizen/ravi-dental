                <p class="form-error" id="first_name_error" data-error-for="first_name"></p>
              </div>
              <div class="form-group">
                <label class="form-label" for="last_name">Last Name *</label>
                <input type="text" id="last_name" name="last_name" class="form-input" autocomplete="family-name" minlength="1" required aria-describedby="last_name_error">
                <p class="form-error" id="last_name_error" data-error-for="last_name"></p>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="email">Email Address *</label>
              <input type="email" id="email" name="email" class="form-input" autocomplete="email" required aria-describedby="email_error">
              <p class="form-error" id="email_error" data-error-for="email"></p>
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Phone Number *</label>
              <input type="tel" id="phone" name="phone" class="form-input" autocomplete="tel" inputmode="tel" pattern="[0-9+() -]{10,20}" required aria-describedby="phone_error">
              <p class="form-error" id="phone_error" data-error-for="phone"></p>
            </div>
            <div class="form-group">
              <label class="form-label" for="service">Service Interested In *</label>
              <select id="service" name="service" class="form-select" required aria-describedby="service_error">
                <option value="">Select a service</option>
                <option>Teeth Whitening</option><option>Tooth Restoration</option><option>Root Canal Treatment</option>
                <option>Paediatric Dentistry</option><option>Extraction</option><option>Ceramic Crown</option>
                <option>Veneers & Laminates</option><option>Dental Implant</option><option>Fixed/Removable Dentures</option>
                <option>Orthodontic Treatment</option><option>Invisible Aligners</option><option>Periodontal Treatment</option>
                <option>Dental Pain Management</option><option>Headache/Migraine</option><option>TMJ/TMD</option>
                <option>Sleep Apnea/Snoring</option><option>Undiagnosed Facial Pain</option>
              </select>
              <p class="form-error" id="service_error" data-error-for="service"></p>
            </div>
            <div class="form-group">
              <label class="form-label" for="message">Message *</label>
              <textarea id="message" name="message" class="form-textarea" placeholder="Tell us about your symptoms or concerns..." minlength="10" required aria-describedby="message_error"></textarea>
              <p class="form-error" id="message_error" data-error-for="message"></p>
            </div>
            <p class="form-status" aria-live="polite"></p>
            <button type="submit" class="btn btn-primary" style="width:100%;">Send Message</button>
          </form>
          <p style="font-size:0.8rem;color:var(--gray-400);margin-top:1rem;text-align:center;">Prefer WhatsApp? <a href="https://wa.me/919962002537" style="color:var(--primary);text-decoration:underline;">Chat with us directly</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

