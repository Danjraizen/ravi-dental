            <div class="float-icon"><i class="fas fa-award"></i></div>
            <div class="float-text">15+ Years<br><span>Clinical Excellence</span></div>
          </div>
          <div class="hero-float-card card-2">
            <div class="float-icon"><i class="fas fa-shield-alt"></i></div>
            <div class="float-text">Safe & Sterile<br><span>Advanced Protocols</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Counter -->
