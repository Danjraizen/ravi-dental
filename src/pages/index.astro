  <section class="hero">
    <div class="hero-shape"></div>
    <div class="container hero-content">
      <div class="hero-grid">
        <div>
          <div class="hero-label">
            <i class="fas fa-star"></i> Trusted Dental & Pain Care in Chennai
          </div>
          <h1 class="hero-title">Your Smile Deserves <span>Expert Care</span></h1>
          <p class="hero-desc">Advanced dental treatments combined with specialized orofacial pain management. From routine checkups to complex TMJ therapy — experience compassionate, precision care at Mogappair's leading dental clinic.</p>
          <div class="hero-btns">
            <a href="/contact/" class="btn btn-accent">Book Consultation</a>
            <a href="/services/" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#fff;">Explore Services</a>
          </div>
          <div class="hero-stats">
            <div class="hero-stat">
              <div class="hero-stat-number" data-counter="15" data-suffix="+">0+</div>
              <div class="hero-stat-label">Years Experience</div>
            </div>
            <div class="hero-stat">
              <div class="hero-stat-number" data-counter="10" data-suffix="K+">0+</div>
              <div class="hero-stat-label">Happy Patients</div>
            </div>
            <div class="hero-stat">
              <div class="hero-stat-number" data-counter="12" data-suffix="+">0+</div>
              <div class="hero-stat-label">Expert Doctors</div>
            </div>
          </div>
        </div>
